# LLM Provider: dashscope | openai | deepseek
LLM_PROVIDER=dashscope

# API Key (required)
LLM_API_KEY=your-api-key-here

# Model name (optional, defaults based on provider)
# DashScope: qwen-plus
# OpenAI: gpt-4o-mini
# DeepSeek: deepseek-chat
LLM_MODEL=

# ── Feishu Open Platform (2026 AI先锋未来人才大赛 · 专属租户自建应用) ──
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_IDS={"courses":"","topics":"","students":"","responses":""}
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_TEACHER_OPEN_ID=
